{
  // ARK Server ASA Configuration
  // This file contains all configuration options for the ARK: Survival Ascended server
  // IMPORTANT: All comments must be removed from the JSON file before it can be used.

  // Optional settings for the server
  "server": {
    "map": "TheIsland_WP", // Map to run. Default is "TheIsland_WP".
    "session_name": "PvP - YINZERS - The Island", // Server session name. Default is "ARK Server".
    "cluster_id": "yinzers", // Cluster ID. Default is "ark".
    "password": "", // Server password. Default is "".
    "admin_password": "" // Admin password. Default is "".
  },

  // Optional settings for the network
  "network": {
    "server_port": "7777", // Server port. Default is "7777".
    "query_port": "27015", // Query port. Default is "27015".
    "rcon_port": "27020" // RCON port. Default is "27020".
  },

  // Optional settings for the gameplay
  // https://ark.wiki.gg/wiki/Server_configuration
  "gameplay": {
    "max_players": "70", // Maximum number of players. Default is "70".
    "battleye": "true", // BattlEye anti-cheat. Default is "true".

    // Extra options are options leading with a ? in the ASA Server Configuration docs.
    // Ommit the leading ? and pass the key and value as a JSON object.
    // None of these are loaded by default.
    "extra_options": {
      "OverrideOfficialDifficulty": "5.0",
      "AllowCrateSpawnsOnTopOfStructures": "true",
      "AllowFlyingStaminaRecovery": "true",
      "ShowFloatingDamageText": "true",
      "MaxPersonalTamedDinos": "500"
    },

    // Extra dash options are options leading with a - in the ASA Server Configuration docs.
    // Ommit the leading - and pass the value as a string.
    // Default: -log -ServerRCONOutputTribeLogs -gameplaylogging -servergamelog -servergamelogincludetribelogs
    "extra_dash_options": [
      "-NoTransferFromFiltering",
      "-ForceAllowCaveFlyers",
      "-usecache",
      "-crossplay",
      "-culture=en",
      "-ForceRespawnDinos"
    ],

    // Mods are passed as an array of mod IDs.
    // None of these are loaded by default.
    "mods": ["936660"]
  },

  // Optional settings for the server manager and server monitor
  "system": {
    "startup_timeout": "300", // Timeout for server startup before it is considered failed (seconds). Default is 5 minutes.
    "startup_wait": "60", // Time to wait for server to initialize (seconds) before starting the countdown to check if the server is running. Default is 60 seconds.
    "warning_time": "5", // Countdown minutes before shutdown or restart. Default is 5 minutes.
    "shutdown_timeout": "30", // Timeout for server shutdown before it is considered failed (seconds). Default is 30 seconds.

    // Optional settings for the server monitor
    "check_interval": "30", // Time between checks to see if the server is running (seconds). Default is 30 seconds.
    "restart_wait": "120", // How long to wait after restart (seconds). Default is 120 seconds.
    "stale_lock_time": "30", // Minutes before considering a lock stale. Default is 30 minutes.
    "max_restart_attempts": "3", // Maximum restart attempts before giving up the monitor gives up. Default is 3.
    "update_check_interval": "12", // Hours between update checks. Default is 12 hours. Set to 0 to disable update checks.
    "initial_startup_delay": "300" // Time to wait before starting the monitor (seconds). Default is 300 seconds.
  },

  // Optional settings for the backup system
  "backup": {
    "max_backups": "10", // Maximum number of backups to keep. Default is 10.
    "compression_level": "5", // Compression level. Default is 5.
    "name_prefix": "ark-backup" // Prefix for the backup file name. Default is "ark-backup".
  },

  // Optional settings for the API
  "api": {
    "enabled": "false", // Enable the API. Default is "false".

    // Optional plugins to load.
    // None of these are loaded by default.
    "plugins": [
      {
        "name": "ServerAPI",
        "url": "https://github.com/ServersHub/ServerAPI/releases/latest/download/ServerAPI.zip"
      },
      {
        "name": "ExamplePlugin",
        "url": "https://example.com/ExamplePlugin.zip"
      }
    ]
  }
}
